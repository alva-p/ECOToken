# ── Base de datos (Prisma / PostgreSQL) ──
DATABASE_URL="postgresql://ecotoken:ecotoken@localhost:5432/ecotoken?schema=public"

# ── App ──
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Auth (JWT) ──
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# ── Blockchain (Sepolia) ──
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/TU_API_KEY
ECOTOKEN_CONTRACT_ADDRESS=0x...
EXPLORER_URL=https://sepolia.etherscan.io

# ── Cuentas operadoras (modelo custodial) ──
# NUNCA commitear las claves reales. En producción usar un gestor de secretos.
MINTER_PRIVATE_KEY=0x...
BURNER_PRIVATE_KEY=0x...
# Cuenta con ADMIN_ROLE/DEFAULT_ADMIN_ROLE on-chain: otorga roles (ej. VALIDATOR_ROLE
# a una cooperativa dada de alta, E4-HU01).
ADMIN_PRIVATE_KEY=0x...
# Clave de cifrado para las claves custodiales de las empresas
WALLET_ENCRYPTION_KEY=cambiar_por_clave_de_cifrado

# ── Certificados mensuales (E8-HU01) ──
# Empresas que reciben certificado al cierre del mes. 0 = todas las que tuvieron aportes.
CERTIFICADOS_TOP_X=0
# kg de CO2 evitado por kg reciclado, por tipo de material.
CERTIFICADOS_FACTOR_CO2_PLASTICO=1.8
CERTIFICADOS_FACTOR_CO2_CARTON=1.5
CERTIFICADOS_FACTOR_CO2_VIDRIO=0.3
