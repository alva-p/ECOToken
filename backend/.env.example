# ── Base de datos (Prisma / PostgreSQL) ──
DATABASE_URL="postgresql://ecotoken:ecotoken@localhost:5432/ecotoken?schema=public"

# ── App ──
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Auth (JWT) ──
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# ── Blockchain (Sepolia) ──
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/TU_API_KEY
ECOTOKEN_CONTRACT_ADDRESS=0x...
EXPLORER_URL=https://sepolia.etherscan.io

# ── Cuentas operadoras (modelo custodial) ──
# NUNCA commitear las claves reales. En producción usar un gestor de secretos.
MINTER_PRIVATE_KEY=0x...
BURNER_PRIVATE_KEY=0x...
# Clave de cifrado para las claves custodiales de las empresas
WALLET_ENCRYPTION_KEY=cambiar_por_clave_de_cifrado
