# ── PostgreSQL (consumido por docker-compose.yml) ──
POSTGRES_USER=ecotoken
POSTGRES_PASSWORD=ecotoken
POSTGRES_DB=ecotoken
POSTGRES_PORT=5432

# ── Docker Compose (servicios locales) ──
BACKEND_PORT=3000
FRONTEND_PORT=5173
BACKEND_DATABASE_URL=postgresql://ecotoken:ecotoken@postgres:5432/ecotoken?schema=public

# ── Variables opcionales del backend para el compose ──
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/TU_API_KEY
ECOTOKEN_CONTRACT_ADDRESS=0x...
EXPLORER_URL=https://sepolia.etherscan.io
MINTER_PRIVATE_KEY=0x...
BURNER_PRIVATE_KEY=0x...
ADMIN_PRIVATE_KEY=0x...
WALLET_ENCRYPTION_KEY=cambiar_por_clave_de_cifrado

# ── Variables opcionales del frontend para el compose ──
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_EXPLORER_URL=https://sepolia.etherscan.io
VITE_CONTRACT_ADDRESS=0x...

# Nota: cada paquete tiene además su propio .env.example
#   backend/.env.example   → DATABASE_URL, JWT_SECRET, SEPOLIA_RPC_URL, claves operadoras
#   frontend/.env.example  → VITE_API_URL, VITE_WS_URL, VITE_EXPLORER_URL
#   contracts/.env.example → SEPOLIA_RPC_URL, DEPLOYER_PRIVATE_KEY, ETHERSCAN_API_KEY
