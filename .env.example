# ── PostgreSQL (consumido por docker-compose.yml) ──
POSTGRES_USER=ecotoken
POSTGRES_PASSWORD=ecotoken
POSTGRES_DB=ecotoken
POSTGRES_PORT=5432

# Nota: cada paquete tiene además su propio .env.example
#   backend/.env.example   → DATABASE_URL, JWT_SECRET, SEPOLIA_RPC_URL, claves operadoras
#   frontend/.env.example  → VITE_API_URL, VITE_WS_URL, VITE_EXPLORER_URL
#   contracts/.env.example → SEPOLIA_RPC_URL, DEPLOYER_PRIVATE_KEY, ETHERSCAN_API_KEY
