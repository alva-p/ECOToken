# Copiar a `.env` en el homelab y completar. NUNCA commitear `.env`.

# ── Base de datos ──
POSTGRES_PASSWORD=generar_con_openssl_rand_hex_24

# ── App ──
# URL pública del frontend en Vercel (CORS y links de verificación de certificados).
CORS_ORIGIN=https://eco-token-ruddy.vercel.app
# Puerto del host donde escucha el backend (cloudflared apunta acá).
BACKEND_HOST_PORT=3300
TRUST_PROXY=2

# ── Auth ──
JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_EXPIRES_IN=1d
WALLET_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# ── Blockchain (Sepolia, SOLO billeteras de testnet sin fondos reales) ──
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/TU_API_KEY
ECOTOKEN_CONTRACT_ADDRESS=0x...
EXPLORER_URL=https://sepolia.etherscan.io
MINTER_PRIVATE_KEY=0x...
# Opcional: el burn (canjes) todavía no se usa.
BURNER_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=0x...
